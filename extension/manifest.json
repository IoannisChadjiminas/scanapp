{
  "manifest_version": 3,
  "name": "Scanapp Cardmarket helper",
  "version": "0.2.12",
  "description": "Quiet background helper that fetches Cardmarket listings for Scanapp, one card at a time.",
  "action": {
    "default_title": "Scanapp Cardmarket helper",
    "default_popup": "popup.html"
  },
  "permissions": ["alarms", "offscreen", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "https://staging-scan.auctaro.com/*",
    "https://www.cardmarket.com/*",
    "https://cardmarket.com/*",
    "https://prices.pokemontcg.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardmarket.com/*",
        "https://cardmarket.com/*"
      ],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["https://www.cardmarket.com/*", "https://cardmarket.com/*"]
    }
  ]
}
