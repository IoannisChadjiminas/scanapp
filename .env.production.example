# Dokploy Compose environment for compose.dokploy.production.yaml.
# Copy into ignored .env-prod locally; paste into the ScanApp service's environment.
# Use a dedicated ScanApp role on pokesingle-product-prod/main, never the API role.
PORTFOLIO_DATABASE_URL=
# Same server-only value as SCANAPP_SERVICE_TOKEN in the PokeSingle API.
SCANAPP_SERVICE_TOKEN=
PLANETSCALE_ENV_FILE=/etc/scanapp-production/planetscale.env
CATALOGUE_RELEASE_ENV_FILE=/etc/scanapp-production/catalogue-release.env

# User capture uploads are handled by the PokeSingle API's private R2 bucket.
STORE_CAPTURES=false
REVIEW_TOKEN=
SCAN_WAIT_LIMIT=2

# Enable only after configuring budgets, storage grants and verifying the provider.
SCRAPER_ENABLED=false
DAILY_PRICES_ENABLED=false
PRICE_GUIDE_ENABLED=false
TCGDEX_PRICES_ENABLED=false
# To run the optional scraper container, also set COMPOSE_PROFILES=scraping.
COMPOSE_PROFILES=
SCRAPER_API_KEY=
