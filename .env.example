# Shared paths inside containers. Host paths are Docker volumes.
DATA_DIR=/data
TMP_DIR=/tmp/scanapp

# Recognition snapshot selected at runtime. Must already exist on the data volume.
PREPROCESS_CONFIG=pad
USE_OCR=true
ENABLE_MATCHED=true
THRESHOLD_MIN_VISUAL=0.78
THRESHOLD_MIN_VISUAL_OCR=0.70

# Inference limits for the 2 GiB target.
ORT_INTRA_THREADS=1
ORT_INTER_THREADS=1
OMP_NUM_THREADS=1
MAX_IMAGE_PIXELS=12000000
MAX_UPLOAD_BYTES=12582912
SCAN_WAIT_LIMIT=2
STORE_CAPTURES=true
# Required to list saved scan photos via /api/v1/review. Keep this out of git.
REVIEW_TOKEN=

# PC extension/CDP price reads are temporarily off. Set true to restore them.
CARDMARKET_HELPER_ENABLED=false

# Bootstrap (tools profile only)
# Comma-separated TCGdex set IDs, or "all" for every set in each language.
# Japanese and Chinese set IDs differ from English; use "all" for full coverage.
CATALOGUE_SETS=base1,sv01,swsh3
TCGDEX_IMAGE_QUALITY=high
TCGDEX_LANGUAGE=en
TCGDEX_LANGUAGES=en,ja,zh-cn,zh-tw
BOOTSTRAP_CONCURRENCY=8
HF_HUB_DISABLE_TELEMETRY=1
EXTRA_CARDS_DIR=/extra-cards
BOOTSTRAP_EXTRAS_ONLY=false

# Local web
HTTP_PORT=8080
HTTPS_PORT=8443
LAN_HTTPS=false

# Production (compose.prod.yaml)
PUBLIC_HOST=scanapp.example.com
