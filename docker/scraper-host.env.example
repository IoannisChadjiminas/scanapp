# Copy to /opt/scanapp-scraper/.env on the scraper host and fill in the empty values.
# Keep the real file off git and off the API host.

# Private address of this host that the API host can reach: the Hetzner Cloud Network IP
# (for example 10.0.0.3) or the Tailscale IP (100.x.y.z). Never 0.0.0.0 or the public IP.
SCRAPER_BIND_ADDR=
SCRAPER_A_PORT=8001
SCRAPER_B_PORT=8002

# Same value as SCRAPER_API_KEY in the Dokploy environment of the API service.
SCRAPER_API_KEY=

# DataImpulse. Copy from the Dokploy environment of the current scraper service.
PROXY_ENABLED=
PROXY_HOST=gw.dataimpulse.com:823
PROXY_USER=
PROXY_PASS=
PROXY_USER_TEMPLATE=
PROXY_COUNTRY=de
PROXY_TZ=Europe/Berlin

SCRAPER_ATTEMPT_SECONDS=90
SCRAPER_PAGE_GAP_S=0
SCRAPER_DIRECT_PROBE=false
SCRAPER_NET_LOG=true
SCRAPER_BROWSER_LIFETIME_S=1800
