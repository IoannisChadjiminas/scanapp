{
	email {$CADDY_EMAIL:}
}

{$SITE_ADDRESS} {
	encode gzip

	handle /api/v1* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} {path}/ {path}.html /index.html
		file_server
	}

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}
